-library: enableOSGi-Test

# The SSH stack has to be asked for by name. org.eclipse.fennec.jgit imports
# org.eclipse.jgit.transport.sshd optionally (issue #49 - a consumer of a local repository
# should not have to ship MINA sshd), so nothing here requires org.eclipse.jgit.ssh.apache any
# more, and without this line the GitSshTransportTest cases all fail to activate the service.
# bcpkix is optional in the same way one level down: it carries BouncyCastle's PKCS#8
# decryptor, which MINA needs to read a key in encrypted PKCS#8 form ("BEGIN ENCRYPTED PRIVATE
# KEY"). Without it testEncryptedPkcs8Key fails with
# NoClassDefFoundError: org/bouncycastle/pkcs/PKCSException.
-runrequires: \
	bnd.identity;id='org.eclipse.fennec.jgit.test',\
	bnd.identity;id='org.eclipse.jgit.ssh.apache',\
	bnd.identity;id='bcpkix'
	
-runbundles.test: \
	org.eclipse.fennec.jgit.test;version=snapshot

-runfw: org.apache.felix.framework

-runee: JavaSE-21

# JGit and MINA sshd are ServiceLoader clients, so the resolver pulls in an Aries SPI Fly
# weaving hook. The framework-extension variant cannot import packages, so it weaves with the
# ASM it embeds - in 1.3.7 that ASM tops out at class file 66 (Java 22) and dies with
# "Unsupported class file major version 69" on a Java 25 JDK, taking every test with it.
# The classic dynamic bundle imports org.objectweb.asm instead and wires to the 9.9.1 bundles
# (class file 70 / Java 26), so force the resolver onto it.
-runblacklist: \
	bnd.identity;id='org.apache.aries.spifly.dynamic.framework.extension'

# org.eclipse.jgit.ssh.apache references javax.security.auth.* (e.g. DestroyFailedException
# when wiping key material) without an Import-Package, expecting it on the boot classpath.
# Felix boot-delegates only java.* by default, so javax.* must be added to bootdelegation.
# The enableOSGi-Test library already sets bootdelegation (to a mockito package) through this
# test-runproperties macro; bootdelegation is a single property, so a separate -runproperties
# entry can't add to it. Override the macro to carry BOTH values (mockito's, verbatim, + javax.*).
test-runproperties: \
	tester.trace=true,\
	org.osgi.framework.bootdelegation='org.mockito.internal.creation.bytebuddy.inject,javax.*'

-runbundles: \
	assertj-core;version='[3.27.7,3.27.8)',\
	bcpkix;version='[1.84.0,1.84.1)',\
	bcprov;version='[1.84.0,1.84.1)',\
	bcutil;version='[1.84.0,1.84.1)',\
	com.googlecode.javaewah.JavaEWAH;version='[1.2.3,1.2.4)',\
	junit-jupiter-api;version='[5.14.2,5.14.3)',\
	junit-jupiter-params;version='[5.14.2,5.14.3)',\
	junit-platform-commons;version='[1.14.2,1.14.3)',\
	net.bytebuddy.byte-buddy;version='[1.18.4,1.18.5)',\
	org.apache.aries.spifly.dynamic.bundle;version='[1.3.7,1.3.8)',\
	org.apache.commons.commons-codec;version='[1.22.0,1.22.1)',\
	org.apache.felix.configadmin;version='[1.9.26,1.9.27)',\
	org.apache.felix.scr;version='[2.2.12,2.2.13)',\
	org.apache.sshd.osgi;version='[2.19.0,2.19.1)',\
	org.apache.sshd.sftp;version='[2.19.0,2.19.1)',\
	org.eclipse.fennec.jgit;version=snapshot,\
	org.eclipse.fennec.jgit.test;version=snapshot,\
	org.eclipse.jgit;version='[7.7.1,7.7.2)',\
	org.eclipse.jgit.ssh.apache;version='[7.7.1,7.7.2)',\
	org.objectweb.asm;version='[9.9.1,9.9.2)',\
	org.objectweb.asm.commons;version='[9.9.1,9.9.2)',\
	org.objectweb.asm.tree;version='[9.9.1,9.9.2)',\
	org.objectweb.asm.tree.analysis;version='[9.9.1,9.9.2)',\
	org.objectweb.asm.util;version='[9.9.1,9.9.2)',\
	org.opentest4j;version='[1.3.0,1.3.1)',\
	org.osgi.service.cm;version='[1.6.1,1.6.2)',\
	org.osgi.service.component;version='[1.5.1,1.5.2)',\
	org.osgi.test.common;version='[1.3.0,1.3.1)',\
	org.osgi.test.junit5;version='[1.3.0,1.3.1)',\
	org.osgi.test.junit5.cm;version='[1.3.0,1.3.1)',\
	org.osgi.util.function;version='[1.2.0,1.2.1)',\
	org.osgi.util.promise;version='[1.3.0,1.3.1)',\
	slf4j.api;version='[2.0.17,2.0.18)',\
	slf4j.simple;version='[2.0.17,2.0.18)'
