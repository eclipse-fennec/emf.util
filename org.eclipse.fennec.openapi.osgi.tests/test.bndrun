-library: enableOSGi-Test

-runsystempackages: com.sun.net.httpserver

# The test bundle plus every runtime that is wired by DS/config (so capability
# resolution alone would not pull it): SCR, ConfigurationAdmin, the metadata
# whiteboard + codec aspect provider, and the codec OpenAPI/JSON-Schema pipeline.
-runrequires: \
	bnd.identity;id='org.eclipse.fennec.openapi.osgi.tests',\
	bnd.identity;id='org.eclipse.fennec.openapi.osgi',\
	bnd.identity;id='org.apache.felix.scr',\
	bnd.identity;id='org.apache.felix.configadmin',\
	bnd.identity;id='org.eclipse.fennec.emf.osgi.metadata',\
	bnd.identity;id='org.eclipse.fennec.codec',\
	bnd.identity;id='org.eclipse.fennec.codec.metadata',\
	bnd.identity;id='org.eclipse.fennec.codec.openapi',\
	bnd.identity;id='org.eclipse.fennec.codec.jsonschema'

-runbundles.test: \
	org.eclipse.fennec.openapi.osgi.tests;version=snapshot

-runfw: org.apache.felix.framework

-runee: JavaSE-21

# Resolved closure (regenerate via `gradlew :…:resolve.test`). Committed so the
# bndrun is launchable from bndtools and reproducible in CI.
-runbundles: \
	com.fasterxml.jackson.core.jackson-annotations;version='[2.21.0,2.21.1)',\
	junit-jupiter-api;version='[5.14.2,5.14.3)',\
	junit-jupiter-params;version='[5.14.2,5.14.3)',\
	junit-platform-commons;version='[1.14.2,1.14.3)',\
	org.apache.felix.configadmin;version='[1.9.26,1.9.27)',\
	org.apache.felix.scr;version='[2.2.12,2.2.13)',\
	org.eclipse.emf.common;version='[2.44.0,2.44.1)',\
	org.eclipse.emf.ecore;version='[2.41.0,2.41.1)',\
	org.eclipse.emf.ecore.xmi;version='[2.39.0,2.39.1)',\
	org.eclipse.fennec.codec;version='[0.1.0,0.1.1)',\
	org.eclipse.fennec.codec.api;version='[0.1.0,0.1.1)',\
	org.eclipse.fennec.codec.jsonschema;version='[0.1.0,0.1.1)',\
	org.eclipse.fennec.codec.metadata;version='[0.1.0,0.1.1)',\
	org.eclipse.fennec.codec.openapi;version='[0.1.0,0.1.1)',\
	org.eclipse.fennec.emf.osgi.component.minimal;version='[1.1.0,1.1.1)',\
	org.eclipse.fennec.emf.osgi.metadata;version='[1.1.0,1.1.1)',\
	org.eclipse.fennec.openapi.model;version='[0.1.0,0.1.1)',\
	org.eclipse.fennec.openapi.osgi;version=snapshot,\
	org.eclipse.fennec.openapi.osgi.tests;version=snapshot,\
	org.eclipse.fennec.service.api;version=snapshot,\
	org.opentest4j;version='[1.3.0,1.3.1)',\
	org.osgi.service.component;version='[1.5.1,1.5.2)',\
	org.osgi.test.common;version='[1.3.0,1.3.1)',\
	org.osgi.test.junit5;version='[1.3.0,1.3.1)',\
	org.osgi.util.converter;version='[1.0.9,1.0.10)',\
	org.osgi.util.function;version='[1.2.0,1.2.1)',\
	org.osgi.util.promise;version='[1.3.0,1.3.1)',\
	tools.jackson.core.jackson-core;version='[3.1.0,3.1.1)',\
	tools.jackson.core.jackson-databind;version='[3.1.0,3.1.1)'