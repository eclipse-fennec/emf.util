Bundle-Name: Eclipse Fennec Mapping OCL
Bundle-Description: OCL expressions for the Fennec mapping: the ExpressionEvaluator of the value \
	ladder, backed by the Fennec M2X OCL engine. The only mapping bundle that depends on an \
	expression language; without it, expressions produce no value.

-workingset: mapping

-library: enableEMF

-buildpath: \
	org.osgi.service.component.annotations;version=latest,\
	org.eclipse.fennec.mapping;version=snapshot,\
	org.eclipse.fennec.m2x.ocl.api;version=latest,\
	org.eclipse.fennec.m2x.ocl.model;version=latest

# The engine and its parser exercise the real thing in plain JUnit tests; at runtime they arrive as services.
-testpath: \
	assertj-core,\
	org.eclipse.fennec.mapping.model;version=latest,\
	org.eclipse.fennec.atlas.configuration.model;version=latest,\
	org.eclipse.fennec.m2x.ocl.engine;version=latest,\
	org.eclipse.fennec.m2x.ocl.parser;version=latest,\
	org.eclipse.fennec.m2x.unit;version=latest,\
	org.antlr.antlr4-runtime;version=latest
