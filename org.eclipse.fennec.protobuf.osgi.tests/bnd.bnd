Test-Cases: ${classes;HIERARCHY_INDIRECTLY_ANNOTATED;org.junit.platform.commons.annotation.Testable;CONCRETE}
Bundle-Name: Fennec EMF Protobuf OSGi Test
Bundle-Description: EMF Protobuf OSGi Integration Test

-library: \
	enableOSGi-Test,\
	enableEMF

-buildpath: \
	org.osgi.framework;version=latest,\
	org.eclipse.fennec.protobuf;version=snapshot,\
	org.eclipse.fennec.emf.osgi.api,\
	com.google.protobuf;version=latest
	