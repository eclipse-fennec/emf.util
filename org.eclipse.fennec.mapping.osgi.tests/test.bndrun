-library: enableOSGi-Test

-runfw: org.apache.felix.framework
-runee: JavaSE-21

-runrequires: \
	bnd.identity;id='org.eclipse.fennec.mapping.osgi.tests',\
	bnd.identity;id='org.eclipse.fennec.mapping.osgi',\
	bnd.identity;id='org.eclipse.fennec.mapping.ocl',\
	bnd.identity;id='org.eclipse.fennec.mapping.model',\
