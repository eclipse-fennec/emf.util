	bnd.identity;id='org.eclipse.fennec.m2x.ocl.engine',\
	bnd.identity;id='org.eclipse.fennec.m2x.ocl.parser',\
	bnd.identity;id='org.apache.felix.configadmin',\
	bnd.identity;id='org.apache.felix.scr',\
	bnd.identity;id='assertj-core'

-runbundles.test: \
	org.eclipse.fennec.mapping.osgi.tests;version=snapshot

-runbundles: \
	assertj-core;version='[3.27.7,3.27.8)',\
	net.bytebuddy.byte-buddy;version='[1.18.4,1.18.5)',\
	org.antlr.antlr4-runtime;version='[4.13.2,4.13.3)',\
