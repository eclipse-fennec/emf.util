Test-Cases: ${classes;HIERARCHY_INDIRECTLY_ANNOTATED;org.junit.platform.commons.annotation.Testable;CONCRETE}
Bundle-Name: Fennec EMF Ecore Documentation Generator OSGi Test
Bundle-Description: OSGi integration test for the Ecore documentation generators: proves that the \
 HTML and the Markdown component each register an EcoreToDocumentationService and that generating \
 works inside a framework, where the Xtend runtime and the class-diagram generators are wired by \
 Import-Package rather than sitting on one flat classpath.

-library: \
	enableOSGi-Test,\
	enableEMF

# The two component bundles are the bundles under test (see -runrequires in test.bndrun). They are
# on the buildpath so bnd/Gradle know this project depends on them: without that edge
# `resolve.test` can run before the component jars are built (races under --parallel) and the
# resolution fails on their osgi.identity.
-buildpath: \
	org.osgi.framework;version=latest,\
	org.eclipse.fennec.emf.util.documentation.generators.apis;version=snapshot,\
	org.eclipse.fennec.emf.util.documentation.generators.html.component;version=snapshot,\
	org.eclipse.fennec.emf.util.documentation.generators.markdown.component;version=snapshot
