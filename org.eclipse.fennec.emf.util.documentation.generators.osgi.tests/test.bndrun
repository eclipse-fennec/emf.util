-library: enableOSGi-Test

-runrequires: \
	bnd.identity;id='org.eclipse.fennec.emf.util.documentation.generators.osgi.tests',\
	bnd.identity;id='org.eclipse.fennec.emf.util.documentation.generators.html.component',\
	bnd.identity;id='org.eclipse.fennec.emf.util.documentation.generators.markdown.component'

-runbundles.test: \
	org.eclipse.fennec.emf.util.documentation.generators.osgi.tests;version=snapshot

-runfw: org.apache.felix.framework

-runee: JavaSE-21
-runbundles: \
	com.google.guava;version='[33.6.0,33.6.1)',\
	com.google.guava.failureaccess;version='[1.0.3,1.0.4)',\
	junit-jupiter-api;version='[5.14.2,5.14.3)',\
	junit-jupiter-params;version='[5.14.2,5.14.3)',\
	junit-platform-commons;version='[1.14.2,1.14.3)',\
	org.apache.felix.scr;version='[2.2.12,2.2.13)',\
	org.eclipse.emf.common;version='[2.44.0,2.44.1)',\
	org.eclipse.emf.ecore;version='[2.41.0,2.41.1)',\
	org.eclipse.fennec.emf.util.documentation.generators.apis;version=snapshot,\
	org.eclipse.fennec.emf.util.documentation.generators.html;version=snapshot,\
	org.eclipse.fennec.emf.util.documentation.generators.html.component;version=snapshot,\
	org.eclipse.fennec.emf.util.documentation.generators.markdown;version=snapshot,\
	org.eclipse.fennec.emf.util.documentation.generators.markdown.component;version=snapshot,\
	org.eclipse.fennec.emf.util.documentation.generators.mermaid;version=snapshot,\
	org.eclipse.fennec.emf.util.documentation.generators.osgi.tests;version=snapshot,\
	org.eclipse.fennec.emf.util.documentation.generators.plantuml;version=snapshot,\
	org.eclipse.xtext.xbase.lib;version='[2.44.0,2.44.1)',\
	org.opentest4j;version='[1.3.0,1.3.1)',\
	org.osgi.service.component;version='[1.5.1,1.5.2)',\
	org.osgi.test.common;version='[1.3.0,1.3.1)',\
	org.osgi.test.junit5;version='[1.3.0,1.3.1)',\
	org.osgi.util.function;version='[1.2.0,1.2.1)',\
	org.osgi.util.promise;version='[1.3.0,1.3.1)'
