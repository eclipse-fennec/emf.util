-include: -secrets.bndrun
			
-runprovidedcapabilities: ${native_capability}

-resolve.effective: active;skip:="osgi.service"

-runbundles: \
	org.apache.felix.gogo.command;version='[1.1.2,1.1.3)',\
	org.apache.felix.gogo.runtime;version='[1.1.6,1.1.7)',\
	org.apache.felix.gogo.shell;version='[1.1.4,1.1.5)',\
	org.apache.felix.scr;version='[2.2.12,2.2.13)',\
	org.osgi.service.component;version='[1.5.1,1.5.2)',\
	org.osgi.util.function;version='[1.2.0,1.2.1)',\
	org.osgi.util.promise;version='[1.3.0,1.3.1)',\
	org.apache.felix.cm.json;version='[2.0.6,2.0.7)',\
	org.apache.felix.configadmin;version='[1.9.26,1.9.27)',\
	org.apache.felix.configurator;version='[1.0.18,1.0.19)',\
	org.eclipse.parsson.jakarta.json;version='[1.1.7,1.1.8)',\
	org.osgi.service.cm;version='[1.6.1,1.6.2)',\
	org.osgi.util.converter;version='[1.0.9,1.0.10)',\
	org.apache.felix.configadmin.plugin.interpolation;version='[1.2.8,1.2.9)',\
	bcprov;version='[1.84.0,1.84.1)',\
	com.googlecode.javaewah.JavaEWAH;version='[1.2.3,1.2.4)',\
	org.apache.commons.commons-codec;version='[1.22.0,1.22.1)',\
	bcpkix;version='[1.84.0,1.84.1)',\
	bcutil;version='[1.84.0,1.84.1)',\
	org.apache.aries.spifly.dynamic.framework.extension;version='[1.3.7,1.3.8)',\
	org.apache.sshd.osgi;version='[2.19.0,2.19.1)',\
	org.apache.sshd.sftp;version='[2.19.0,2.19.1)',\
	org.eclipse.fennec.jgit;version=snapshot,\
	org.eclipse.fennec.jgit.config;version=snapshot,\
	org.eclipse.jgit;version='[7.7.1,7.7.2)',\
	org.eclipse.jgit.ssh.apache;version='[7.7.1,7.7.2)',\
	org.objectweb.asm;version='[9.9.1,9.9.2)',\
	org.objectweb.asm.commons;version='[9.9.1,9.9.2)',\
	org.objectweb.asm.tree;version='[9.9.1,9.9.2)',\
	org.objectweb.asm.tree.analysis;version='[9.9.1,9.9.2)',\
	org.objectweb.asm.util;version='[9.9.1,9.9.2)',\
	slf4j.api;version='[2.0.17,2.0.18)',\
	slf4j.simple;version='[2.0.17,2.0.18)'

-runrequires: \
	osgi.identity;filter:='(osgi.identity=org.apache.felix.gogo.shell)',\
	osgi.identity;filter:='(osgi.identity=org.apache.felix.gogo.command)',\
	bnd.identity;id='org.apache.felix.configadmin.plugin.interpolation',\
	bnd.identity;id=bcpkix,\
	bnd.identity;id=bcutil,\
	bnd.identity;id='org.eclipse.fennec.jgit',\
	bnd.identity;id='org.eclipse.fennec.jgit.config'
-runfw: org.apache.felix.framework;version='[7.0.5,7.0.5]'
-runee: JavaSE-21