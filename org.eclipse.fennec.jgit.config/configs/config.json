{
  ":configurator:resource-version": 1,

  "GitConfig~models":
  {
    "repo": "git@github.com:eclipse-fennec/emf.util.git",
    "branch": "main",
    "privateKey": "$[env:SSH_PRIVATE_KEY;default=$[prop:SSH_PRIVATE_KEY;default=]]",
    "privateKeyPassphrase":"$[env:SSH_PRIVATE_KEY_PWD;default=$[prop:SSH_PRIVATE_KEY_PWD;default=]]",
    "knownHosts":"$[env:SSH_KNOWN_HOSTS;default=$[prop:SSH_KNOWN_HOSTS;default=]]"
	}
}
