	org.eclipse.fennec.codec.api;version='[0.1.0,0.1.1)',\
	org.eclipse.fennec.codec.jsonschema;version='[0.1.0,0.1.1)',\
	org.eclipse.fennec.codec.metadata;version='[0.1.0,0.1.1)',\
	org.eclipse.fennec.codec.openapi;version='[0.1.0,0.1.1)',\
	org.eclipse.fennec.model.metadata;version='[1.0.0,1.0.1)',\
	org.eclipse.fennec.model.metadata.api;version='[1.0.0,1.0.1)',\
