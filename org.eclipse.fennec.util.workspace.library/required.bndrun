-runfw: org.apache.felix.framework
-runee: JavaSE-21

-runrequires: \
	bnd.identity;id='org.eclipse.fennec.protobuf',\
	bnd.identity;id='org.eclipse.fennec.protobuf.osgi',\
	bnd.identity;id='org.eclipse.fennec.protobuf.ecore',\
	bnd.identity;id='org.eclipse.fennec.soap',\
	bnd.identity;id='org.eclipse.fennec.soap.osgi',\
	bnd.identity;id='org.eclipse.fennec.soap.ecore',\
	bnd.identity;id='org.eclipse.fennec.openapi.client',\
	bnd.identity;id='org.eclipse.fennec.openapi.ecore',\
	bnd.identity;id='org.eclipse.fennec.openapi.osgi',\
	bnd.identity;id='org.eclipse.fennec.grpc',\
	bnd.identity;id='io.grpc.netty',\
	bnd.identity;id='org.eclipse.fennec.sensinact.mapping'
# io.grpc comes from the gecko wrap bundles (org.geckoprojects.libraries:io.grpc.core /
# io.grpc.netty in central.mvn — upstream grpc jars ship no OSGi metadata). io.grpc.netty is
# required explicitly so consumers get the recommended transport (+ the official io.netty
# bundles) in the closure; the core wrap alone would resolve but leave no way to open a channel.

-runbundles: \
	org.eclipse.fennec.protobuf;version=snapshot,\
	com.google.protobuf;version='[4.35.1,4.35.2)',\
	org.apache.felix.scr;version='[2.2.12,2.2.13)',\
	org.eclipse.emf.common;version='[2.44.0,2.44.1)',\
	org.eclipse.emf.ecore;version='[2.41.0,2.41.1)',\
	org.eclipse.emf.ecore.xmi;version='[2.39.0,2.39.1)',\
	org.eclipse.fennec.emf.osgi.component.minimal;version='[0.1.2,0.1.3)',\
	org.eclipse.fennec.protobuf.osgi;version=snapshot,\
	org.osgi.service.cm;version='[1.6.1,1.6.2)',\
	org.osgi.service.component;version='[1.5.1,1.5.2)',\
	org.osgi.util.converter;version='[1.0.9,1.0.10)',\
	org.osgi.util.function;version='[1.2.0,1.2.1)',\
	org.osgi.util.promise;version='[1.3.0,1.3.1)',\
	org.eclipse.fennec.soap;version=snapshot,\
	org.eclipse.fennec.soap.osgi;version=snapshot,\
	org.xmlsoap.model;version='[1.1.0,1.1.1)',\
	org.eclipse.fennec.protobuf.ecore;version=snapshot,\
	org.eclipse.fennec.soap.ecore;version=snapshot,\
	org.eclipse.xsd;version='[2.22.0,2.22.1)',\
	com.fasterxml.jackson.core.jackson-annotations;version='[2.21.0,2.21.1)',\
