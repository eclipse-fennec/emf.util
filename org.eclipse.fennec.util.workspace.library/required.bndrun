	tools.jackson.core.jackson-core;version='[3.1.0,3.1.1)',\
	tools.jackson.core.jackson-databind;version='[3.1.0,3.1.1)',\
	com.google.errorprone.annotations;version='[2.50.0,2.50.1)',\
	com.google.gson;version='[2.14.0,2.14.1)',\
	com.google.guava;version='[33.6.0,33.6.1)',\
	com.google.guava.failureaccess;version='[1.0.3,1.0.4)',\
	io.grpc.core;version='[1.82.2,1.82.3)',\
