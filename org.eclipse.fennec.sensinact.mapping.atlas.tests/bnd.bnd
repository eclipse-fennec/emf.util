Bundle-Name: SensiNact Mapping Atlas Tests
Bundle-Description: OSGi integration test for the atlas-fed EObject registry pipeline: \
 a mock Model Atlas served over a local HttpServer delivers ProviderMapping XMIs and \
 the sensor-model EPackage; the atlas provider syncs them into a named EObject \
 registry, whose listener face feeds the sensinact mapping facades.

Test-Cases: ${classes;HIERARCHY_INDIRECTLY_ANNOTATED;org.junit.platform.commons.annotation.Testable;CONCRETE}

-workingset: SensiNact

-library: \
	enableOSGi-Test,\
	enableEMF

# org.eclipse.fennec.model.atlas.eobject.provider is the bundle under test (see -runrequires
# in test.bndrun). It is on the buildpath so bnd/Gradle know this project depends on it:
# without that edge `resolve.test` can run before the provider jar is built (races under
# --parallel) and the resolution fails on
# osgi.identity=org.eclipse.fennec.model.atlas.eobject.provider.
-buildpath: \
	org.osgi.framework;version=latest,\
	org.osgi.service.cm;version=latest,\
	org.osgi.test.junit5.cm;version=latest,\
	org.osgi.util.promise;version=latest,\
	org.eclipse.sensinact.gateway.core.api;version=latest,\
	org.eclipse.fennec.emf.osgi.api;version=latest,\
	org.eclipse.fennec.emf.osgi.eobject.registry;version=latest,\
	org.eclipse.fennec.sensinact.mapping;version=snapshot,\
	org.eclipse.fennec.model.atlas.eobject.provider;version=snapshot

# Fixtures come straight from the sibling sensinact.mapping.tests bundle - the same
# mapping XMI and sensor .ecore, here served by the mock atlas instead of the classpath.
# The WeatherReports mapping (collection selectors) is the master copy from the core bundle.
-includeresource: \
	data/WeatherProviderMapping.xmi=${workspace}/org.eclipse.fennec.sensinact.mapping.tests/data/WeatherProviderMapping.xmi,\
	data/WeatherReportsProviderMapping.xmi=${workspace}/org.eclipse.fennec.sensinact.mapping/model/WeatherReportsProviderMapping.xmi,\
	data/dwd-weather.ecore=${workspace}/org.eclipse.fennec.sensinact.mapping.tests/model/dwd-weather.ecore
