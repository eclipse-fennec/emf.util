-library: enableOSGi-Test

# The mock Model Atlas runs on the JDK HttpServer inside the test bundle.
-runsystempackages: com.sun.net.httpserver

# The test bundle plus everything wired only by DS/config (capability resolution
# alone would not pull it): the bridge, the atlas rest client, the JakartaRS client
# runtime (ClientBuilder service), the fennec EMF runtime (default EPackage.Registry),
# the sensinact gateway (ProviderMappingRegistry whiteboard) and ConfigAdmin.
# The weather sensor model bundle is deliberately ABSENT - the test proves the
# EPackage is fetched from the atlas.
-runrequires: \
	bnd.identity;id='org.eclipse.fennec.sensinact.mapping.atlas.tests',\
	bnd.identity;id='org.eclipse.fennec.sensinact.mapping.atlas',\
	bnd.identity;id='org.eclipse.fennec.model.atlas.rest.client.osgi',\
	bnd.identity;id='org.eclipse.osgitech.rest',\
	bnd.identity;id='org.eclipse.fennec.emf.osgi.component',\
	bnd.identity;id='org.eclipse.sensinact.gateway.core.impl',\
	bnd.identity;id='org.apache.aries.typedevent.bus',\
	bnd.identity;id='org.apache.felix.configadmin'

-runbundles.test: \
	org.eclipse.fennec.sensinact.mapping.atlas.tests;version=snapshot

-runfw: org.apache.felix.framework;version='[7.0.5,7.0.5]'

-runee: JavaSE-21

# Resolved closure (regenerate via `gradlew :org.eclipse.fennec.sensinact.mapping.atlas.tests:resolve.test`).
# Committed so the bndrun is launchable from bndtools and reproducible in CI.
-runbundles: \
	com.fasterxml.jackson.core.jackson-annotations;version='[2.21.0,2.21.1)',\
	io.dropwizard.metrics.core;version='[4.2.37,4.2.38)',\
	jakarta.activation-api;version='[2.1.3,2.1.4)',\
	jakarta.annotation-api;version='[2.1.1,2.1.2)',\
	jakarta.inject.jakarta.inject-api;version='[2.0.1,2.0.2)',\
	jakarta.validation.jakarta.validation-api;version='[3.0.2,3.0.3)',\
	jakarta.ws.rs-api;version='[3.1.0,3.1.1)',\
	jakarta.xml.bind-api;version='[4.0.2,4.0.3)',\
	javassist;version='[3.29.2,3.29.3)',\
	junit-jupiter-api;version='[5.14.2,5.14.3)',\
	junit-jupiter-params;version='[5.14.2,5.14.3)',\
