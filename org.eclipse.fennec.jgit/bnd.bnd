-library: enableEMF

# JGit logs through slf4j; without an API on the path its SystemReader fails to initialize.
-testpath: \
	assertj-core;version=latest,\
	slf4j.api;version='[2.0,3)'

-buildpath: \
	org.eclipse.jgit;version=latest,\
	org.eclipse.jgit.ssh.apache;version=latest

# The SSH backend is only built when a private key is configured, and it lives in its own
# class so nothing loads it otherwise. Importing it optionally keeps consumers that read a
# local repository, an anonymous git:// or an https remote from having to resolve the
# Apache MINA sshd stack.
Import-Package: \
	org.eclipse.jgit.transport.sshd;resolution:=optional,\
	*



