Bundle-Name: MAC Management Git Webhook REST
Bundle-Description: Whiteboard REST endpoints receiving GitHub/GitLab push webhooks for the git storage backend

-library: enableEMF

# jakarta.ws.rs-api is API only: building a Response looks up a RuntimeDelegate through the
# ServiceLoader, which fails with "Provider for jakarta.ws.rs.ext.RuntimeDelegate cannot be
# found" unless an implementation is on the path. At runtime the whiteboard brings one; the
# plain-JUnit tests need their own.
-testpath: \
	org.glassfish.jersey.core.jersey-common;version=latest

-buildpath: \
	org.eclipse.fennec.git.webhook.model;version=snapshot,\
	org.eclipse.fennec.git.github.webhook.model;version=snapshot,\
	org.eclipse.fennec.git.gitlab.webhook.model;version=snapshot,\
	org.eclipse.fennec.codec.rest;version=latest,\
	jakarta.ws.rs-api;version=latest,\
	org.osgi.service.typedevent;version=latest,\
	org.osgi.service.component;version=latest,\
	org.osgi.service.component.annotations;version=latest,\
	org.osgi.service.jakartars;version=latest
