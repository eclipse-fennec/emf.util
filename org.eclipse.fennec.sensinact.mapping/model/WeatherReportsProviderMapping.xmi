          href="http://cdc.dwd.de/common/weather#//MOSMIXSWeatherReport/tempMaxLast12"/>
    </resources>

    <!-- Precipitation resources -->
    <resources
        name="precipitationProbabilityNoRain"
        unit="%"
        mid="precipitationNoRain">
      <eType
          xsi:type="ecore:EDataType"
          href="http://www.eclipse.org/emf/2002/Ecore#//EFloat"/>
      <valueFeature
          xsi:type="ecore:EAttribute"
          href="http://cdc.dwd.de/common/weather#//MOSMIXSWeatherReport/precipitationLarger00Last12"/>
    </resources>
    <resources
