      <valueFeature
          xsi:type="ecore:EAttribute"
          href="http://cdc.dwd.de/common/weather#//MOSMIXSWeatherReport/precipitationLarger10Last12"/>
    </resources>

    <!-- Weather warning -->
    <resources
        name="significantWeather"
        mid="significantWeather">
      <eType
          xsi:type="ecore:EDataType"
          href="http://www.eclipse.org/emf/2002/Ecore#//EString"/>
      <valueFeature
          xsi:type="ecore:EAttribute"
          href="http://cdc.dwd.de/common/weather#//MOSMIXSWeatherReport/significantWeather3Hours"/>
    </resources>
