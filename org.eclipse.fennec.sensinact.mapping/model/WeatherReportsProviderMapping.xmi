        mid="windGustLastHour">
      <eType
          xsi:type="ecore:EDataType"
          href="http://www.eclipse.org/emf/2002/Ecore#//EFloat"/>
      <valueFeature
          xsi:type="ecore:EAttribute"
          href="http://cdc.dwd.de/common/weather#//MOSMIXSWeatherReport/windGustLastHour"/>
    </resources>

    <!-- Cloud resources -->
    <resources
        name="cloudCoverTotal"
        unit="%"
        mid="cloudCoverTotal">
      <eType
          xsi:type="ecore:EDataType"
          href="http://www.eclipse.org/emf/2002/Ecore#//EFloat"/>
      <valueFeature
          xsi:type="ecore:EAttribute"
          href="http://cdc.dwd.de/common/weather#//MOSMIXSWeatherReport/cloudCoverTotal"/>
