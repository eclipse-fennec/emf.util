Bundle-Name: Gecko EMF SensiNact Model (deprecated, moved to event.atlas)
Bundle-Description: DEPRECATED - moved to the eclipse-fennec/event.atlas repository, this copy is frozen (see README.md). \
 EMF models for SensiNact provider mappings, sensor data structures, and IoT device integration. Provides data models for sensor registration, data mapping, and IoT gateway communication.

-workingset: SensiNact

src: src-gen,src
# sets the usually required buildpath using the bnd library, you can extend it with the normal -buildpath to your liking
-library: enableEMF

# The code generation takes a bit of time and makes the build a bit slower.
# It might be a good idea to put comments around it, when you don't need it
-generate:\
	model/sensinact-mapping.genmodel;\
		generate=fennecEMF;\
		genmodel=model/sensinact-mapping.genmodel;\
		output=src-gen
# Add this attribute to find some logging information
#		logfile=test.log;\

# If this is not done with a instruction namespace, bnd would think you like
# to take full control over whats exported and imported and will ignore @Export
# Bundle Annotations		
-includeresource.model: model=model

-includeresource: \
	data=data

Bundle-Version: 1.0.0.SNAPSHOT

-buildpath: \
	org.eclipse.fennec.emf.osgi.eobject.registry;version=latest,\
	org.osgi.util.promise;version=latest,\
	slf4j.api;version=latest,\
	com.fasterxml.jackson.core.jackson-annotations;version=latest,\
	org.eclipse.sensinact.gateway.core.api;version=latest,\
	org.eclipse.sensinact.gateway.core.models.provider;version=latest,\
	org.eclipse.sensinact.gateway.core.geo-json;version=latest,\
	org.eclipse.sensinact.gateway.core.emf-api;version=latest,\
	tools.jackson.core.jackson-core;version=latest,\
	tools.jackson.core.jackson-databind;version=latest,\

Import-Package: \
        org.eclipse.sensinact.*;resolution:=optional,\
        *
